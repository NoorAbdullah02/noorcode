{
  "name": "@noorcode/cli",
  "version": "1.0.32",
  "module": "src/index.tsx",
  "type": "module",
  "private": false,
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "noorcode": "bin/noorcode.js"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun run build.ts",
    "compile": "bun build src/index.tsx --compile --outfile dist/noorcode",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@noorcode/server": "workspace:*",
    "@noorcode/shared": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.2.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.186",
    "@opentui/core": "^0.1.97",
    "@opentui/react": "^0.1.97",
    "@types/diff": "^8.0.0",
    "ai": "^6.0.184",
    "chokidar": "^5.0.0",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "hono": "^4.12.29",
    "open": "^11.0.0",
    "opentui-spinner": "^0.0.6",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.4",
    "react-router": "^7.14.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.11",
    "zod": "^4.3.6"
  }
}