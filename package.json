{
  "name": "noorcode",
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:cli": "bun run --watch packages/cli/src/index.tsx",
    "dev:server": "bun run --hot packages/server/src/index.ts",
    "build:cli": "bun run --filter @noorcode/cli build",
    "link:cli": "bun run build:cli && cd packages/cli && bun link",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "dependencies": {
    "@cerebras/cerebras_cloud_sdk": "^1.64.1",
    "dotenv": "^17.4.2",
    "open": "^11.0.0"
  }
}